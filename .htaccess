# ====================================================================
# HOSTINGER LITESPEED & APACHE REVERSE PROXY CONFIGURATION
# SI PANTAI GIZI - PUSKESMAS KEPULAUAN SERIBU SELATAN
# Solusi Definitif Mengatasi 403 Forbidden pada sipantaigizi.puskesmasseribuselatan.com
# ====================================================================

# 1. Izinkan akses penuh ke direktori dan cegah 403 Forbidden dari web server
<IfModule mod_authz_core.c>
  Require all granted
</IfModule>

# Matikan directory browsing bawaan server namun tetapkan index default
Options -Indexes +FollowSymLinks

# 2. Konfigurasi CloudLinux Passenger (Hostinger NodeJS Selector)
# Jika Hostinger hPanel Node.js App diaktifkan, Passenger mengeksekusi server.js langsung
<IfModule mod_passenger.c>
  PassengerAppType node
  PassengerStartupFile server.js
  PassengerEnabled on
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 3. Lewatkan HANYA file fisik statis yang benar-benar ada di disk (seperti gambar, favicon, manifest)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 4. Teruskan semua rute halaman & API ke aplikasi Node.js Next.js (port 3000 jika mod_proxy tersedia)
  <IfModule mod_proxy.c>
    RewriteRule ^(.*)$ http://127.0.0.1:3000/$1 [P,L]
  </IfModule>
</IfModule>

# 5. Header forwarding untuk SSL / HTTPS di Hostinger
<IfModule mod_headers.c>
  RequestHeader set X-Forwarded-Proto "https" env=HTTPS
  RequestHeader set X-Forwarded-Port "443" env=HTTPS
</IfModule>
